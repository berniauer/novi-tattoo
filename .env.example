# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Vorlage für die echten .env-Dateien
# Kopiere und befülle:
#   cp .env.example .env.local        (Next.js lokal)
#   cp .env.example .env.prod         (Next.js auf VPS)
#   cp .env.example .env.directus     (Directus auf VPS)
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js (.env.local / .env.prod) ─────────────────────────────────────────
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=dein-static-token-aus-directus-admin

# ── Directus (.env.directus, nur auf VPS) ─────────────────────────────────────
SECRET=ersetze-mich-mit-langem-zufallsstring
ADMIN_EMAIL=admin@novitattoo.at
ADMIN_PASSWORD=sicheres-passwort

DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

CORS_ENABLED=true
CORS_ORIGIN=https://deine-domain.at

WEBSOCKETS_ENABLED=true

# Instagram Graph API (nach Meta-App-Setup befüllen)
INSTAGRAM_ACCESS_TOKEN=

# E-Mail (optional — für Buchungsbestätigungen)
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=booking@novitattoo.at

# ── VPS Domain (.env.prod) ───────────────────────────────────────────────────
DOMAIN=deine-domain.at
